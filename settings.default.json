// Settings for the bar, beside shell.qml.
//
// settings.default.json comes with the bar: every setting with its default and
// what it does. It is replaced on every update, so leave it alone. settings.json
// is yours: it starts as a copy of the defaults, git ignores it, and the bar
// picks it up the moment you save it. A key you delete from it falls back to
// its default.
//
// // comments and trailing commas are fine. A file that does not parse is
// reported as a notification, and the last settings that did parse stay.
{
    // --- where the bar goes ----------------------------------------------

    // Monitors that get a bar, by the names `hyprctl monitors` prints, e.g.
    // ["DP-1", "HDMI-A-1"]. Empty: every monitor.
    "screens": [],

    // --- what the bar shows ----------------------------------------------

    // The settings window (the gear) places right pill modules as Auto,
    // Pinned, or Drawer. Quiet modules stay behind the chevron in Auto;
    // a middle click pins one outside the drawer or returns it to Auto.

    // One icon per app on each workspace in the left pill, opened into one
    // per window by a click. false gives every window its own icon.
    "groupWindows": true,

    // Mark collapsed app groups in the left pill: "hide", "dot", or "badge"
    // (window count). Single windows and expanded groups have no indicator.
    "groupWindowBadgeStyle": "hide",

    // Drag modules between the central and right pills, or within a pill to
    // reorder them. Moving to the right pins the module; Drawer settings can
    // return it to Auto or keep it behind the chevron, in either pill.
    // The last central module is locked. Positions use <module>Position:
    // centre or right.
    "datePosition": "centre",
    "weatherPosition": "centre",
    "timePosition": "centre",

    // Scroll overflowing track titles in the music pill and player.
    // Off keeps titles truncated. Reduce motion also stops scrolling.
    "scrollMusicTitles": true,

    // Show the Now Playing pill for apps that report media through MPRIS.
    "showMpris": true,

    // Module indicators: "badge" shows the count, "dot" shows a corner dot,
    // "underdot" centers a dot below the icon, "hide" hides the indicator.
    // Module visibility stays the same.
    "emailBadgeStyle": "badge",
    "tasksBadgeStyle": "badge",
    "countdownBadgeStyle": "badge",
    "bellBadgeStyle": "badge",
    "updaterBadgeStyle": "badge",
    "feedsBadgeStyle": "badge",

    // The date, as a Qt date format: "ddd d MMM" reads Tue 13 Oct,
    // "dd/MM/yyyy" reads 13/10/2026. Weekday and month names use your locale.
    // https://doc.qt.io/qt-6/qml-qtqml-qt.html#formatDate-method
    "dateFormat": "ddd d MMM",

    // Letter case for the bar date: normal, capitalize, uppercase or lowercase.
    // Capitalize makes the first character of each space-separated word uppercase.
    "dateCase": "normal",

    // The clock, as a Qt time format: "HH:mm" reads 14:05, "h:mm AP" reads
    // 2:05 PM, and anything with seconds ("HH:mm:ss") ticks every second.
    // Alarms follow the same 12h/24h notation, always without seconds.
    // https://doc.qt.io/qt-6/qml-qtqml-qt.html#formatDateTime-method
    "timeFormat": "HH:mm",

    // Letter case for the bar clock and alarm times: uppercase or lowercase.
    "timeCase": "uppercase",

    // Draw AM/PM at two-thirds font size in bar clock and alarm readouts, on
    // the same baseline without a preceding space. Popup times keep AM/PM at
    // full size with a space for readability. Requires a 12h clock format.
    "smallAmPm": false,

    // Independent feedback options when the active keyboard layout changes.
    // Notifications are transient; the module reveal lasts three seconds.
    // Show and bounce reveals the module for three seconds and bounces once.
    "layoutChangeNotification": false,
    "layoutChangeBounce": false,

    // What the language module shows for each keyboard layout, keyed by the
    // name `hyprctl devices` gives it. A layout not listed here shows its
    // first two letters.
    "layoutNames": {
        "English (US)": "EN",
        "English (UK)": "UK",
        "Greek": "GR",
        "German": "DE",
        "French": "FR",
        "Spanish": "ES",
    },

    // --- how it looks ------------------------------------------------------

    // The bar's text, and the monospaced face for code and package lists.
    // Icons always come from Symbols Nerd Font (ttf-nerd-fonts-symbols).
    "font": "Inter",
    "monoFont": "IosevkaTerm Nerd Font Mono",

    // Workspace parallax is toggled in the wallpaper popup. Extra zoom leaves
    // room to pan across and, with the popup's track, to move the picture up
    // and down; 1 disables both. Motion follows the workspace glide spring.
    "wallpaperParallaxZoom": 1.08,

    // macOS's two accessibility switches. Reduce motion takes the bounce out
    // of every spring, stops the attention hop, the drawer's wind-up and the
    // wallpaper's parallax, and opens popups, the launcher and the power menu
    // in place rather than sliding or wiping them in; fades stay. Reduce
    // transparency makes the pills and everything that hangs off the bar a
    // solid dark surface instead of glass.
    "reduceMotion": false,
    "reduceTransparency": false,

    // --- apps it opens -----------------------------------------------------

    // Opens btop, yazi, the editor and the Google sign-in. Whatever it is
    // must accept --title=<title> and -e <command> (kitty, alacritty, foot
    // and ghostty all do).
    "terminal": "kitty",

    // For the launcher's files. Empty: $EDITOR, or nvim without one.
    "editor": "",

    // For folders: the launcher's, a drive's, the wallpapers'. xdg-open hands
    // them to your default file manager. Flags may follow the program, as in
    // "dolphin --new-window".
    "fileManager": "xdg-open",

    // Include apps' desktop actions in launcher results. Individual hiddenApps
    // exclusions still apply when this is on.
    "showDesktopActions": false,

    // Desktop entries the launcher leaves out, by id (the file name without
    // .desktop). Quickshell ignores OnlyShowIn, so an entry meant for another
    // desktop shows up unless it is listed here (blueman-adapters is
    // OnlyShowIn=XFCE;MATE). A desktop action is hidden by "app:action", the
    // id from its [Desktop Action ...] header. Hidden here are the ones that
    // only open the app they hang off (LibreOffice's "New Spreadsheet", a
    // browser's "New Window") or that the app's own window does better
    // (Steam's pages, Telegram's Quit). Chromium's incognito action is also
    // hidden. Firefox's private window is available when showDesktopActions
    // is on. The launcher's
    // controls and power commands hide as "desktop:<key>" and "power:<key>"
    // (desktop:mute, power:reboot).
    "hiddenApps": [
        "blueman-adapters", "libreoffice-startcenter",
        "libreoffice-writer:NewDocument", "libreoffice-calc:NewDocument",
        "libreoffice-impress:NewDocument", "libreoffice-draw:NewDocument",
        "libreoffice-base:NewDocument", "libreoffice-math:NewDocument",
        "firefox:new-window", "chromium:new-window",
        "chromium:new-private-window",
        "code-oss:new-empty-window", "cursor:new-empty-window",
        "org.telegram.desktop:quit",
        "steam:Store", "steam:Community", "steam:Library", "steam:Servers",
        "steam:Screenshots", "steam:News", "steam:Settings",
        "steam:BigPicture", "steam:Friends"
    ],

    // --- where things are --------------------------------------------------
    // ~ and $XDG_RUNTIME_DIR are expanded.

    // The images the wallpaper module cycles through (jpg and png).
    "wallpaperDir": "~/Pictures/Wallpapers",

    // Mail attachments saved from the bar.
    "downloadsDir": "~/Downloads",

    // Shell command run by the screenshot button, with no arguments added.
    // The tool handles capture and output. Empty hides the button.
    "screenshotCommand": "",

    // Extra fd ignore file for launcher searches. Empty uses fd's normal rules.
    "fileSearchIgnore": "",

    // The bar speaks to mpd over a unix socket, which mpd.conf has to open
    // alongside whatever else it listens on:
    //   bind_to_address "$XDG_RUNTIME_DIR/mpd.sock"
    "mpdSocket": "$XDG_RUNTIME_DIR/mpd.sock",

    // External helpers for power, display, updates and cleanup.
    "scriptsDir": "~/_scripts",

    // App desktop IDs for gmail, calendar and tasks. An empty value detects
    // an installed Chromium PWA; "browser" always opens the website.
    // Choose another browser's PWA in Settings > Apps & Services.
    // Missing apps use the website.
    "webApps": {},

    // --- Google ------------------------------------------------------------
    // Mail, Tasks and the calendar's agenda need a one-time sign-in with your
    // own Google Cloud OAuth client: run scripts/gtasks-auth, or click
    // reconnect in any of their popups.
    // Default task list ID for new tasks. Leave empty to use the first task list.
    "defaultTaskList": "",

    // The Gmail inbox tabs whose unread the mail badge counts and the popup
    // lists: any of "primary", "updates", "promotions", "social", "forums".
    // The rest folds into one Other row. Empty: the whole inbox's unread.
    "mailCategories": [],

    // The feeds module (newspaper) counts new videos from your YouTube
    // subscriptions. It has its own sign-in: click Connect YouTube in its
    // popup and pick the account or brand channel with the subscriptions,
    // and enable the YouTube Data API v3 in the Google console. Shorts,
    // livestreams and premieres are left out.
    // Channels to follow without subscribing, as @handles, channel ids
    // (UC…) or links to either.
    "feedChannels": [],

    // RSS or Atom feeds shown under the videos. hnrss.org's points= keeps
    // Hacker News to what made the front page properly.
    "feedUrls": ["https://hnrss.org/frontpage?points=300"],
    // Optional display titles, keyed by RSS or Atom feed URL.
    "feedTitles": {},
}
