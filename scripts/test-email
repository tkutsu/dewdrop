#!/usr/bin/env python3
"""Exercise the installed email QML methods and text control with offline fixtures."""
import base64
import json
import os
from pathlib import Path
import re
import shutil
import textwrap
import tempfile
import unittest

from test_support import copy_shell

os.environ['QT_QPA_PLATFORM'] = 'offscreen'
from PySide6.QtCore import QPoint, QPointF, Qt, QUrl
from PySide6.QtGui import QGuiApplication, QWheelEvent
from PySide6.QtQml import QQmlComponent, QQmlEngine, QQmlExpression
from PySide6.QtQuick import QQuickItem, QQuickTextDocument, QQuickWindow
from PySide6.QtTest import QTest

CONFIG = Path(__file__).resolve().parents[1]
APP = QGuiApplication.instance() or QGuiApplication([])
SERVICE = (CONFIG / 'services/Email.qml').read_text()
POPUP = (CONFIG / 'components/EmailPopup.qml').read_text()
# copy() writes the real clipboard through Quickshell; the fixture records it.
METHODS = '\n'.join(m for m in re.findall(r'^    function .*?^    }', SERVICE, re.M | re.S) if not m.startswith('    function copy('))
BODY = textwrap.dedent(re.search(r'^(?P<indent> +)TextEdit \{.*?^(?P=indent)}', POPUP, re.M | re.S).group())

STATE = '''
    property string api: "https://fixture.invalid"
    property int generation: 0
    property var cache: ({})
    property var opened: ({})
    property int detailed: 12
    property bool morePending: false
    property bool loading: false
    function refresh() { root.fetchThreads(); }
    onLoadingChanged: root.flushMore()
    property var threads: []
    property int total: 0
    property int other: 0
    property var otherThreads: []
    property var files: ({})
    property var saving: ({})
    property string web: "https://mail.google.com/mail/u/0/"
    property real newestSeen: -1
    property bool popupOpen: false
    signal summoned
    property int summons: 0
    onSummoned: summons++
    property var cards: []
    property string copied: ""
    function copy(text) { copied = text; }
    QtObject { id: card; function createObject(parent, props) { root.cards.push(props); return props; } }
    property bool otherWanted: false
    property var categories: ["primary"]
    property var pending: []
    property int undoMs: 4000
    property var said: ({archive: "Archived", read: "Marked read", star: "Starred", unstar: "Unstarred"})
    signal restored(var row, bool wasOpen)
    property var restoredWith: null
    onRestored: (row, wasOpen) => restoredWith = {id: row.id, wasOpen: wasOpen}
    Timer { id: dueTimer; onTriggered: root.commitDue() }
    property bool loaded: false
    property string snapshot: ""
    property string trouble: ""
    property var found: null
    property int searches: 0
    property int searchMax: 10
    property var bodies: ({})
    property var reading: ({})
    property var readQueue: []
    property int bodyRequests: 0
    property int bodyParallel: 4
    property int headerParallel: 6
    property int bodyKeep: 200
    property string fixtureText: ""
    property var requests: []
    property int maxPending: 0
    function authorised(then, failed) { then(); }
    function send(method, url, body, then, failed) {
        requests.push({method: method, url: url, body: body, then: then, failed: failed});
        maxPending = Math.max(maxPending, requests.length);
    }
    function fail(why, status) { trouble = why; }
    function reply(body, index) { requests.splice(index ?? 0, 1)[0].then(body); }
    function reject(index, status, why) { requests.splice(index ?? 0, 1)[0].failed(why ?? "fixture failure", status ?? 503); }
    // The poll's two lists: Primary's unread, then the whole inbox's.
    function isPrimary(r) { return r.url.includes("category%3Aprimary"); }
    function isAll(r) { return r.url.includes("labelIds=UNREAD") && !isPrimary(r); }
    function replyPrimary(body) { reply(body, requests.findIndex(isPrimary)); }
    function replyAll(body) { reply(body, requests.findIndex(isAll)); }
    function lists(primary, rest) {
        replyPrimary({threads: primary});
        replyAll({threads: primary.concat(rest ?? [])});
    }
'''


def encoded(text):
    return base64.urlsafe_b64encode(text.encode()).decode().rstrip('=')


class EmailTests(unittest.TestCase):
    def setUp(self):
        self.engine = QQmlEngine()
        self.components = []
        self.root = self.create('import QtQuick\nimport \"services/EmailEntities.js\" as EmailEntities\nItem { id: root\n' + STATE + METHODS + '\n}')
        self.engine.rootContext().setContextProperty('sut', self.root)
        self.engine.rootContext().setContextProperty('Email', self.root)
        self.notices = self.create('import QtQuick\nQtObject { property var withdrawn: []; function withdraw(hint, value) { withdrawn = withdrawn.concat([hint + "=" + value]); } }')
        self.engine.rootContext().setContextProperty('Notifications', self.notices)
        self.popup_state = self.create('import QtQuick\nItem { property bool shown: true; function dismiss() { shown = false; } function close(item) { dismiss(); } }')
        self.engine.rootContext().setContextProperty('OpenPopup', self.popup_state)
        self.theme = {
            'bodyFont': 'Sans Serif', 'captionSize': 12,
            'fg': '#ffffff', 'label': '#ffffff', 'label2': '#aaaaaa', 'label3': '#888888', 'warn': '#ff8800', 'selection': '#444488',
            'scrollEdge': 16, 'footnoteSize': 10, 'popupTextSize': 12, 'selectionRadius': 4, 'foldMs': 0, 'fadeMs': 0, 'figures': {},
            'badgeFg': '#ffffff', 'pillBorder': 1, 'stroke': '#333333', 'well': '#222222',
            'drawerSpring': 2.2, 'drawerDamping': 0.2,
            'monogramTones': ['#5e7896', '#7a6a96', '#94677c', '#94785e', '#5e8a74', '#5e8a91', '#8a8257', '#6f7680'],
            'glyph': {'openApp': 'o', 'plus': '+', 'mailRead': 'r', 'mailArchive': 'a', 'mailStar': 'S', 'mailStarred': 's',
                      'undo': 'u', 'sectionOpen': 'v', 'sectionShut': '>'},
        }
        self.engine.rootContext().setContextProperty('Theme', self.theme)

    def tearDown(self):
        self.engine.rootContext().setContextProperty('Email', None)
        self.engine.rootContext().setContextProperty('sut', None)
        self.engine.rootContext().setContextProperty('OpenPopup', None)
        self.engine.rootContext().setContextProperty('Notifications', None)
        self.popup_state.deleteLater()
        self.root.deleteLater()
        self.engine.deleteLater()
        APP.processEvents()

    def create(self, source, directory=CONFIG):
        component = QQmlComponent(self.engine)
        component.setData(source.encode(), QUrl.fromLocalFile(str(directory / 'tests-fixture.qml')))
        self.components.append(component)
        result = component.create()
        self.assertIsNotNone(result, '\n'.join(e.toString() for e in component.errors()))
        return result

    def js(self, code):
        expr = QQmlExpression(self.engine.rootContext(), self.root, '(function () {' + code + '\n})()')
        value, _ = expr.evaluate()
        self.assertFalse(expr.hasError(), expr.error().toString())
        return value

    def text_of(self, payload):
        self.js('sut.loadText("fixture", ' + json.dumps(payload) + ', function(text) { sut.fixtureText=text; }, function(why) { throw Error(why); });')
        return self.js('return sut.fixtureText;')

    def check(self, expression):
        self.assertTrue(self.js('return ' + expression + ';'), expression)

    def test_search_list_failure_stays_local(self):
        self.js('sut.total=7; sut.loaded=true; sut.threads=[{id:"inbox"}]; sut.search("bad query", false); sut.reject();')
        self.check('sut.found.q === "bad query" && sut.found.trouble === "fixture failure" && sut.found.rows.length === 0')
        self.check('sut.trouble === "" && sut.total === 7 && sut.loaded && sut.threads[0].id === "inbox"')

    def test_search_header_failure_stays_local(self):
        self.js('sut.search("query", false); sut.reply({threads:[{id:"t"}]}); sut.reject();')
        self.check('sut.found.q === "query" && sut.found.trouble === "fixture failure" && sut.found.rows.length === 0')
        self.check('sut.trouble === ""')

    def test_stale_search_failure_preserves_current_results(self):
        self.js('sut.search("old", false); sut.search("current", false); sut.reply({threads:[]}, 1); sut.reject();')
        self.check('sut.found.q === "current" && sut.found.trouble === "" && sut.trouble === ""')

    def test_starred_search_failure_is_not_overwritten(self):
        self.js('sut.search("query", true); sut.reject(); sut.reply({threads:[]});')
        self.check('sut.found.q === "query" && sut.found.trouble === "fixture failure" && sut.trouble === ""')

    def test_search_preserves_existing_inbox_failure(self):
        self.js('sut.trouble="inbox failure"; sut.search("query", false); sut.reject();')
        self.check('sut.trouble === "inbox failure" && sut.found.trouble === "fixture failure"')

    def test_search_can_retry_after_failure(self):
        self.js('sut.search("query", false); sut.reject(); sut.search("query", false); sut.reply({threads:[{id:"t"}]}); sut.reply({messages:[{id:"m",internalDate:"10"}]});')
        self.check('sut.found.q === "query" && sut.found.trouble === "" && sut.found.rows.length === 1 && sut.trouble === ""')

    def test_stale_search_header_failure_preserves_current_results(self):
        self.js('sut.search("old", false); sut.reply({threads:[{id:"t"}]}); sut.search("current", false); sut.reply({threads:[]}, 1); sut.reject();')
        self.check('sut.found.q === "current" && sut.found.trouble === "" && sut.trouble === ""')

    def test_search_header_failure_stops_queued_details(self):
        self.js('sut.search("query", false); sut.reply({threads:Array.from({length:10}, (_,i)=>({id:"t"+i}))}); sut.reject(); while(sut.requests.length) sut.reply({messages:[{id:"m"}]});')
        self.check('sut.found.trouble === "fixture failure" && sut.trouble === "" && sut.requests.length === 0')
        self.check('sut.maxPending === sut.headerParallel')

    def test_search_preserves_api_and_reconnect_errors(self):
        self.engine.rootContext().setContextProperty('Google', {'reconnect': 'reconnect'})
        self.js('sut.search("query", false); sut.reject(0, 403, "disabled");')
        self.check('sut.found.trouble === "Gmail API not enabled in the Google console" && sut.trouble === ""')
        self.js('sut.search("query", false); sut.reject(0, 403, "reconnect");')
        self.check('sut.found.trouble === "reconnect" && sut.trouble === ""')

    def test_inbox_header_failure_still_sets_inbox_status(self):
        self.js('sut.fetchThreads(); sut.lists([{id:"t"}]); sut.reject();')
        self.check('sut.trouble === "fixture failure" && sut.found === null')

    def test_named_and_numeric_entities(self):
        self.check('sut.unentity("&nbsp;&copy;&mdash;&eacute;&#x1F600;&#39;") === "\\u00a0©—é😀\\\'"')
        self.check('sut.unentity("&#1114112; &#xD800; &#0;") === "� � �"')
        self.check('sut.unentity("&unknown; &constructor; &toString; &amp;lt; &#38;amp;") === "&unknown; &constructor; &toString; &lt; &amp;"')
        self.check('sut.unentity("&NotEqualTilde;&ZeroWidthSpace;&#128;") === "≂̸\\u200b€"')
        self.check('sut.unentity("<b> &lt;b&gt;\\nline") === "<b> <b>\\nline"')

    def test_html_layout_and_links(self):
        html = '<head>hidden</head><style>x</style><!-- hidden --><div> One </div>\n    <div> Two&nbsp; &copy; </div><a href="https://example.com?a=1&amp;b=2">Visit</a><script>hidden</script>'
        self.check('sut.unquote(sut.untag(' + json.dumps(html) + ')) === "One\\nTwo ©\\nVisit (https://example.com?a=1&b=2)"')
        self.check('sut.untag("<a href=javascript:bad>Label</a>") === "Label"')
        self.check('sut.untag("<a href=https://example.com>https://example.com</a>") === "https://example.com"')
        self.check('sut.untag("<table><tr><td>A</td><td>B</td></tr></table>").trim() === "A B"')

    def test_html_quoted_replies_are_not_repeated_in_chain(self):
        self.check('sut.unquote(sut.untag("<div>New</div><div class=\\"gmail_quote\\"><blockquote>Old reply</blockquote></div>")) === "New"')
        self.check('sut.unquote(sut.untag("<div>New</div><blockquote type=\\"cite\\">Old reply</blockquote>")) === "New"')
        self.check('sut.unquote(sut.untag("<blockquote>Newsletter quotation</blockquote>")) === "Newsletter quotation"')

    def test_plain_text_and_reply_history(self):
        self.check('sut.unquote("Hi  \\r\\n\\r\\n\\r\\nBye\\u00a0\\u200b\\rOn Monday Ann\\nwrote:\\nquoted") === "Hi\\n\\nBye"')
        self.check('sut.unquote("New\\n> quoted\\nEnd") === "New\\nEnd"')
        self.check('sut.unquote("  if (x) {\\n    y();\\n  }") === "if (x) {\\n    y();\\n  }"')

    def test_utf8_and_nested_mime(self):
        plain = encoded('Καλημέρα 😀\n\nHello')
        attachment = encoded('wrong attachment')
        payload = {'mimeType': 'multipart/mixed', 'parts': [
            {'mimeType': 'text/plain', 'filename': 'note.txt', 'body': {'data': attachment}},
            {'mimeType': 'multipart/alternative', 'parts': [
                {'mimeType': 'text/html', 'body': {'data': encoded('<p>HTML</p>')}},
                {'mimeType': 'text/plain', 'body': {'data': plain}},
            ]},
        ]}
        self.assertEqual(self.text_of(payload), "Καλημέρα 😀\n\nHello")
        self.check('sut.utf8([0xf4,0xbf,0xbf,0xbf,0xed,0xa0,0x80,0xc0,0xaf,0xe2]) === "�".repeat(10)')
        self.assertEqual(self.text_of(None), "")

    def test_unread_chain_order_and_read_reply_exclusion(self):
        self.js('''
            var messages = [
                {id: "new", internalDate: "30", labelIds: ["UNREAD"], payload: {headers: [{name:"From",value:"New <new@example.com>"}]}},
                {id: "read", internalDate: "40", labelIds: []},
                {id: "old", internalDate: "10", labelIds: ["UNREAD"], snippet: "&copy;"}
            ];
            var row = sut.rowOf({id:"t",snippet:"&copy;"}, {messages: messages});
            if (row.message !== "new" || row.at !== 30 || row.from !== "New" || row.messages.map(m=>m.id).join() !== "old,new" || row.messages[0].snippet !== "©" || messages[0].id !== "new") throw Error("wrong unread chain");
        ''')
        self.check('sut.rowOf({id:"t"}, {messages:[]}).subject === "(no subject)"')
        self.check('sut.rowOf({id:"t"}, {messages:[{id:"old",internalDate:10},{id:"new",internalDate:20}]}).message === "new"')

    def test_1201_threads_across_pages_and_poll_cache(self):
        self.js('''
            function listed(start, count) { return Array.from({length:count}, (_,i)=>({id:"t"+(start+i),historyId:"1"})); }
            function pages(reply) {
                reply({threads:listed(0,500),nextPageToken:"page + /"});
                if (!sut.requests.some(r => r.url.includes("pageToken=page%20%2B%20%2F"))) throw Error("unescaped token");
                reply({threads:listed(499,500),nextPageToken:"last"});
                reply({threads:listed(999,202)});
            }
            sut.fetchThreads();
            pages(sut.replyPrimary);
            if (sut.loaded) throw Error("published before the second list");
            pages(sut.replyAll);
            if (sut.requests.length !== sut.headerParallel || sut.loaded) throw Error("wrong detail limit or partial publication");
            while (sut.requests.length) {
                const id = sut.requests[0].url.match(/threads\\/(t\\d+)/)[1];
                sut.reply({messages:[{id:"m"+id,internalDate:String(2000-Number(id.slice(1))),labelIds:["UNREAD"]}]});
            }
            if (sut.total !== 1201 || sut.other !== 0 || sut.threads.length !== 12 || !sut.loaded) throw Error("wrong paginated total");
            sut.fetchThreads();
            sut.replyPrimary({threads:listed(0,500),nextPageToken:"p2"});
            sut.replyPrimary({threads:listed(500,500),nextPageToken:"p3"});
            sut.replyPrimary({threads:listed(1000,201)});
            sut.replyAll({threads:listed(0,1201)});
            if (sut.requests.length !== 0 || sut.total !== 1201) throw Error("cache missed");
        ''')

    def test_picked_tabs_are_one_query(self):
        self.js('sut.categories = ["primary", "updates"]; sut.fetchThreads();')
        self.check('sut.requests.length === 2 && sut.requests.some(r => r.url.includes("&q=category%3Aprimary%20OR%20category%3Aupdates&"))')

    def test_no_tabs_picked_counts_the_whole_inbox(self):
        self.js('''
            sut.categories = [];
            sut.fetchThreads();
            if (sut.requests.length !== 1 || sut.requests[0].url.includes("&q=")) throw Error("asked for more than the inbox");
            sut.replyAll({threads: [{id: "a", historyId: "1"}, {id: "b", historyId: "1"}]});
            while (sut.requests.length) {
                const id = sut.requests[0].url.match(/threads\\/(\\w+)\\?/)[1];
                sut.reply({messages:[{id:"m"+id,internalDate:"1",labelIds:["UNREAD"]}]});
            }
        ''')
        self.check('sut.total === 2 && sut.other === 0 && sut.threads.length === 2')

    def test_primary_counts_and_other_is_the_rest(self):
        self.js('''
            const t = id => ({id: id, historyId: "1"});
            sut.fetchThreads();
            sut.lists([t("p1"), t("p2")], [t("o1"), t("o2"), t("o3")]);
            while (sut.requests.length) {
                const id = sut.requests[0].url.match(/threads\\/(\\w+)\\?/)[1];
                sut.reply({messages:[{id:"m"+id,internalDate:"1",labelIds:["UNREAD"]}]});
            }
        ''')
        # Only Primary is detailed until the Other row unfolds.
        self.check('sut.total === 2 && sut.other === 3 && sut.threads.length === 2 && sut.otherThreads.length === 0')
        self.check('sut.cache.p1 && !sut.cache.o1')
        self.js('''
            sut.otherWanted = true; sut.fetchThreads();
            sut.lists([{id:"p1",historyId:"1"},{id:"p2",historyId:"1"}], [{id:"o1",historyId:"1"},{id:"o2",historyId:"1"},{id:"o3",historyId:"1"}]);
            if (sut.requests.length !== 3) throw Error("asked again for detailed Primary rows");
            while (sut.requests.length) {
                const id = sut.requests[0].url.match(/threads\\/(\\w+)\\?/)[1];
                sut.reply({messages:[{id:"m"+id,internalDate:"1",labelIds:["UNREAD"]}]});
            }
        ''')
        self.check('sut.total === 2 && sut.other === 3 && sut.otherThreads.length === 3')

    def test_load_more_waits_for_current_requests_and_can_retry(self):
        self.js('sut.threads=Array.from({length:12},(_,i)=>({id:"t"+i})); sut.loading=true; sut.loadMore(16);')
        self.check('sut.detailed === 20 && sut.morePending && sut.requests.length === 0')
        self.js('sut.loading=false;')
        self.check('!sut.morePending && sut.requests.length === 2 && sut.requests.every(r => r.url.includes("labelIds=INBOX&labelIds=UNREAD"))')
        self.js('sut.reject(); sut.reject(); sut.loadMore(16);')
        self.check('sut.requests.length === 2 && sut.detailed === 20')

    def test_load_more_uses_already_loaded_threads(self):
        self.js('sut.threads=Array.from({length:20},(_,i)=>({id:"t"+i})); sut.loadMore(16);')
        self.check('sut.requests.length === 0 && !sut.morePending')

    def test_missing_history_id_fetches_details(self):
        self.js('sut.fetchThreads(); sut.lists([{id:"t"}]);')
        self.check('sut.requests.length === 1 && sut.requests[0].url.includes("threads/t?")')

    def test_uncached_thread_without_history_id_is_detailed(self):
        self.js('sut.detail([{id:"t"}], rows => sut.found = rows);')
        self.check('sut.requests.length === 1 && sut.found === null')
        self.js('sut.reply({messages:[{id:"m",labelIds:["UNREAD"]}]});')
        self.check('sut.found.length === 1')

    def test_header_requests_are_bounded(self):
        self.js('''
            sut.detailed = 200;
            sut.fetchThreads();
            sut.lists(Array.from({length:200}, (_,i)=>({id:"t"+i,historyId:"1"})));
            while (sut.requests.length)
                sut.reply({messages:[{id:"m"+sut.requests.length,internalDate:"1",labelIds:["UNREAD"]}]});
        ''')
        self.check('sut.maxPending <= sut.headerParallel + 1 && sut.loaded && sut.total === 200')

    def test_repeated_token_and_failed_page_preserve_state(self):
        self.js('sut.total=77; sut.loaded=true; sut.fetchThreads(); sut.replyPrimary({threads:[{id:"t"}],nextPageToken:"same"}); sut.replyPrimary({nextPageToken:"same"}); sut.replyAll({threads:[]});')
        self.check('sut.requests.length === 0 && sut.total === 77 && sut.trouble.includes("page token")')
        self.js('sut.fetchThreads(); sut.replyPrimary({nextPageToken:"second"}); sut.replyAll({threads:[]}); sut.reject();')
        self.check('sut.total === 77 && sut.trouble === "fixture failure"')

    def test_opened_thread_stays_hidden_until_gmail_catches_up(self):
        self.js('''
            sut.threads=[sut.rowOf({id:"t"},{messages:[{id:"m",labelIds:["UNREAD"]}]})]; sut.total=1;
            sut.drop(sut.threads[0]); sut.fetchThreads();
            sut.lists([{id:"t",historyId:"old"}]);
            while (sut.requests.length) sut.reply({messages:[{id:"m",labelIds:["UNREAD"]}]});
        ''')
        self.check('sut.total === 0 && sut.threads.length === 0 && !!sut.opened.t')

    def test_thread_marked_unread_again_returns_after_confirmation(self):
        for history in ('after', 'before', None):
            with self.subTest(history=history):
                self.js('''
                    sut.opened={}; sut.cache={t:{historyId:"before",row:sut.rowOf({id:"t"},{messages:[{id:"m",internalDate:10,labelIds:["UNREAD"]}]})}};
                    sut.total=1; sut.threads=[sut.cache.t.row]; sut.drop(sut.threads[0]);
                ''')
                self.check('sut.total === 0 && sut.threads.length === 0')
                self.js('sut.fetchThreads(); sut.lists([]);')
                self.js('sut.fetchThreads(); sut.lists([{id:"t",historyId:' + json.dumps(history) + '}]); while(sut.requests.length) sut.reply({messages:[{id:"m",internalDate:10,labelIds:["UNREAD"]}]});')
                self.check('sut.total === 1 && sut.threads.length === 1 && !sut.opened.t')

    def test_thread_dropped_during_pagination_stays_hidden(self):
        self.js('''
            sut.threads=[sut.rowOf({id:"t"},{messages:[{id:"m",labelIds:["UNREAD"]}]})]; sut.total=1;
            sut.fetchThreads();
            sut.replyPrimary({threads:[{id:"t",historyId:"1"}],nextPageToken:"last"});
            sut.replyAll({threads:[{id:"t",historyId:"1"}]});
            sut.drop(sut.threads[0]);
            sut.replyPrimary({threads:[]});
        ''')
        self.check('sut.total === 0 && sut.threads.length === 0 && sut.requests.length === 0')
        self.js('sut.opened.t = Date.now() - 30001; sut.fetchThreads(); sut.lists([{id:"t",historyId:"2"}]); while(sut.requests.length) sut.reply({messages:[{id:"m",labelIds:["UNREAD"]}]});')
        self.check('sut.total === 1 && sut.threads.length === 1')

    def test_server_confirmed_read_thread_stays_absent(self):
        self.js('''
            sut.threads=[sut.rowOf({id:"t"},{messages:[{id:"m",labelIds:["UNREAD"]}]})]; sut.total=1;
            sut.drop(sut.threads[0]); sut.fetchThreads(); sut.lists([]);
        ''')
        self.check('sut.total === 0 && sut.threads.length === 0 && Object.keys(sut.opened).length === 0')

    def test_stale_poll_and_open_during_metadata(self):
        self.js('''
            sut.fetchThreads(); sut.fetchThreads();
            sut.replyPrimary({threads:[{id:"stale",historyId:"1"}]});
            sut.replyAll({threads:[{id:"stale",historyId:"1"}]});
            sut.lists([{id:"current",historyId:"1"}]);
            sut.opened={current:Date.now()};
            sut.reply({messages:[{id:"m",labelIds:["UNREAD"]}]});
        ''')
        self.check('sut.total === 0 && sut.threads.length === 0 && sut.requests.length === 0')

    # --- the action queue ----------------------------------------------------

    def seed(self, ids, other=()):
        rows = ','.join('sut.rowOf({id:"%s"},{messages:[{id:"m%s",internalDate:%d,labelIds:["UNREAD"]}]})' % (i, i, 100 - n) for n, i in enumerate(ids))
        others = ','.join('sut.rowOf({id:"%s"},{messages:[{id:"m%s",internalDate:%d,labelIds:["UNREAD"]}]})' % (i, i, 50 - n) for n, i in enumerate(other))
        self.js('sut.threads=[%s]; sut.total=%d; sut.otherThreads=[%s]; sut.other=%d; sut.loaded=true;' % (rows, len(ids), others, len(other)))

    def test_action_waits_then_commits(self):
        self.seed(['a', 'b'])
        self.js('sut.undoMs = 60; sut.act("archive", sut.threads[0]);')
        self.check('sut.threads.map(t=>t.id).join() === "b" && sut.total === 1 && sut.pending.length === 1 && sut.requests.length === 0')
        QTest.qWait(120)
        self.check('sut.pending.length === 0 && sut.requests.length === 1')
        self.check('sut.requests[0].url.endsWith("threads/a/modify") && JSON.stringify(sut.requests[0].body.removeLabelIds) === \'["INBOX","UNREAD"]\'')

    def test_verbs_send_the_right_labels(self):
        self.seed(['a', 'b', 'c'])
        self.js('''
            sut.act("read", sut.threads[0]);
            sut.act("star", sut.threads[0]);
            sut.act("unstar", sut.threads[1]);
            sut.flush();
        ''')
        self.check('sut.requests.length === 3 && sut.pending.length === 0')
        self.check('sut.requests[0].url.endsWith("threads/a/modify") && JSON.stringify(sut.requests[0].body) === \'{"removeLabelIds":["UNREAD"]}\'')
        self.check('sut.requests[1].url.endsWith("messages/mb/modify") && JSON.stringify(sut.requests[1].body) === \'{"addLabelIds":["STARRED"]}\'')
        self.check('sut.requests[2].url.endsWith("threads/c/modify") && JSON.stringify(sut.requests[2].body) === \'{"removeLabelIds":["STARRED"]}\'')

    def test_star_turns_in_place_and_undoes(self):
        self.seed(['a'])
        self.js('sut.cache={a:{historyId:"1",row:sut.threads[0]}}; sut.act("star", sut.threads[0]);')
        self.check('sut.threads.length === 1 && sut.threads[0].starred && sut.cache.a.row.starred && sut.total === 1')
        self.js('sut.undo();')
        self.check('!sut.threads[0].starred && !sut.cache.a.row.starred && sut.pending.length === 0')
        self.js('sut.flush();')
        self.check('sut.requests.length === 0')

    def test_undo_restores_order_and_open_state(self):
        self.seed(['a', 'b', 'c'])
        self.js('sut.act("archive", sut.threads[1], {wasOpen: true}); sut.act("read", sut.threads[0]);')
        self.check('sut.threads.map(t=>t.id).join() === "c" && sut.total === 1')
        self.js('sut.undo();')
        self.check('sut.threads.map(t=>t.id).join() === "a,c" && sut.total === 2 && sut.restoredWith.id === "a" && !sut.restoredWith.wasOpen')
        self.js('sut.undo();')
        self.check('sut.threads.map(t=>t.id).join() === "a,b,c" && sut.total === 3 && sut.restoredWith.id === "b" && sut.restoredWith.wasOpen')
        self.check('Object.keys(sut.opened).length === 0 && sut.pending.length === 0')
        self.js('sut.flush();')
        self.check('sut.requests.length === 0')

    def test_undo_returns_an_other_row_to_other(self):
        self.seed(['a'], other=['x', 'y'])
        self.js('sut.act("archive", sut.otherThreads[0]);')
        self.check('sut.other === 1 && sut.total === 1 && sut.otherThreads.map(t=>t.id).join() === "y"')
        self.js('sut.undo();')
        self.check('sut.other === 2 && sut.total === 1 && sut.otherThreads.map(t=>t.id).join() === "x,y" && sut.threads.length === 1')

    def test_flush_sends_everything_at_once(self):
        self.seed(['a', 'b'])
        self.js('sut.act("archive", sut.threads[0]); sut.act("archive", sut.threads[0]); sut.flush();')
        self.check('sut.pending.length === 0 && sut.requests.length === 2 && sut.total === 0')
        self.js('sut.undo();')
        self.check('sut.total === 0')

    def test_compound_action_sends_its_extra_part_on_commit(self):
        self.seed(['a'])
        self.js('sut.found = 0; sut.act("archive", sut.threads[0], {said: "Task made", also: () => sut.found = 1});')
        self.check('sut.pending[0].said === "Task made" && sut.found === 0')
        self.js('sut.undo(); sut.flush();')
        self.check('sut.found === 0 && sut.requests.length === 0')
        self.js('sut.act("archive", sut.threads[0], {also: () => sut.found = 1}); sut.flush();')
        self.check('sut.found === 1 && sut.requests.length === 1')

    def test_poll_during_the_wait_does_not_bring_a_row_back(self):
        self.seed(['a', 'b'])
        self.js('''
            sut.cache = {a:{historyId:"1",row:sut.threads[0]}, b:{historyId:"1",row:sut.threads[1]}};
            sut.act("archive", sut.threads[0]);
            sut.opened.a = Date.now() - 60000;
            sut.fetchThreads();
            sut.lists([{id:"a",historyId:"1"},{id:"b",historyId:"1"}]);
        ''')
        self.check('sut.threads.map(t=>t.id).join() === "b" && sut.total === 1 && sut.pending.length === 1')
        self.js('sut.undo();')
        self.check('sut.threads.map(t=>t.id).join() === "a,b" && sut.total === 2')

    def test_many_replies_are_deduplicated_and_bounded(self):
        self.js('''
            var row={messages:Array.from({length:150},(_,i)=>({id:"m"+i,snippet:"fallback"}))};
            sut.read(row); sut.read(row);
            if (sut.requests.length !== 4 || sut.readQueue.length !== 146) throw Error("unbounded or duplicate requests");
            while (sut.requests.length) sut.reply({payload:{mimeType:"text/plain",body:{data:"SGVsbG8"}}});
            if (Object.keys(sut.bodies).length !== 150 || sut.maxPending !== 4 || sut.bodyRequests !== 0 || Object.keys(sut.reading).length) throw Error("missing bodies or stuck requests");
            sut.read(row);
            if (sut.requests.length) throw Error("cached body fetched twice");
        ''')

    def test_large_inline_body_fetch_and_failure_retry(self):
        self.js('sut.read({messages:[{id:"large",snippet:"fallback"}]}); sut.reply({payload:{mimeType:"text/plain",body:{attachmentId:"large + /",size:200000}}});')
        self.check('sut.bodyRequests === 1 && sut.requests.length === 1 && sut.requests[0].url.includes("attachments/large%20%2B%20%2F?fields=data")')
        self.js('sut.reply({data:"SGVsbG8"});')
        self.check('sut.bodies.large === "Hello" && sut.bodyRequests === 0')
        self.js('sut.read({messages:[{id:"fail",snippet:"fallback"}]}); sut.reply({payload:{mimeType:"text/html",body:{attachmentId:"a"}}}); sut.reject();')
        self.check('sut.bodyRequests === 0 && !sut.reading.fail && sut.bodies.fail === undefined')

    def test_body_failure_can_be_retried(self):
        self.js('sut.read({messages:[{id:"m",snippet:"fallback"}]}); sut.reject();')
        self.check('sut.bodyRequests === 0 && !sut.reading.m && sut.bodies.m === undefined')
        self.js('sut.read({messages:[{id:"m",snippet:"fallback"}]}); sut.reply({payload:null});')
        self.check('sut.bodies.m === "fallback"')

    def test_body_cache_keeps_the_newest(self):
        self.js('sut.bodyKeep = 3; for (const id of ["a", "b", "c", "d"]) { sut.read({messages:[{id:id,snippet:id}]}); sut.reply({payload:null}); }')
        self.check('Object.keys(sut.bodies).join() === "b,c,d"')
        self.js('sut.read({messages:[{id:"a",snippet:"a"}]});')
        self.check('sut.requests.length === 1')

    def test_link_markup_and_escaping(self):
        self.check('sut.richText("<img src=x> https://example.com?a=1&b=2. www.example.com").includes("&lt;img src=x&gt;")')
        self.check('sut.richText("https://example.com?a=1&b=2.").includes("href=\\"https://example.com?a=1&amp;b=2\\"")')
        self.check('sut.richText("(https://example.com/a_(b)).").includes("href=\\"https://example.com/a_(b)\\"")')
        self.check('!sut.richText("javascript:bad file:///tmp/x").includes("<a ")')
        self.check('sut.richText("www.example.com").includes("href=\\"https://www.example.com\\"")')

    def build_popup(self, fold_ms=360):
        """The full popup with its real row and text components, only window
        chrome, buttons and external services replaced with offline stubs."""
        self.engine.rootContext().setContextProperty('Google', {'reconnect': 'reconnect'})
        self.engine.rootContext().setContextProperty('Theme', dict(self.theme, foldMs=fold_ms))
        stubs = {
            'Popup.qml': """import QtQuick
                Item { id: chrome; property real reserveHeight: 0; property var screen: null; property Item anchorItem
                    property real vPadding: 6
                    property real bottomPadding: 12
                    readonly property real chromeHeight: column.implicitHeight + vPadding * 2
                    default property alias content: column.data
                    property alias spacing: column.spacing
                    implicitWidth: column.implicitWidth; implicitHeight: Math.max(chromeHeight, reserveHeight)
                    width: implicitWidth; height: implicitHeight
                    Column { id: column }
                }""",
            'PopupHeader.qml': 'import QtQuick\nRow { property string title; property bool addable: false; signal add }',
            'PopupButton.qml': '''import QtQuick
                Item { id: button; property bool framed; property string glyph; property string label; property string name: label
                    property bool live: true; property int glyphSize; property int textSize; property bool keyed: false
                    signal tapped(); width: 20; height: 20
                    Accessible.role: Accessible.Button; Accessible.name: name
                    TapHandler { gesturePolicy: TapHandler.ReleaseWithinBounds; onTapped: if (button.live) button.tapped() } }''',
            'Glyph.qml': 'import QtQuick\nText { property int fontSize }',
            'ReconnectButton.qml': 'import QtQuick\nItem {}',
            'RetryButton.qml': 'import QtQuick\nItem { property var service }',
            'PressGlass.qml': 'import QtQuick\nQtObject { required property Item icon; required property var area; property bool down; property real scale: 1 }',
        }
        directory = tempfile.mkdtemp(prefix='email-popup-test-')
        self.addCleanup(shutil.rmtree, directory, True)
        copy_shell(directory)
        components = Path(directory, 'components')
        for path in components.glob('*.qml'):
            path.write_text(re.sub(r'^import qs(?:\.\w+)?\n', '', path.read_text(), flags=re.M))
        for name in ['PopupRow.qml', 'PopupText.qml']:
            stubs[name] = (CONFIG / 'components' / name).read_text().replace('import qs\n', '').replace('import Quickshell\n', '').replace('QsWindow.window?.keyItem', 'false')
        for name, source in stubs.items():
            (components / name).write_text(source)
        source = re.sub(r'^import qs(?:\.\w+)?\n', '', POPUP, flags=re.M)
        source = source.replace('Qt.openUrlExternally(url);', 'root.testActivated = url;')
        source = source.replace('id: more\n', 'id: more\n                objectName: "emailMore"\n', 1)
        source = source.replace('id: root', 'id: root\n    property string testActivated: ""\n    property alias testMore: more\n    property alias testList: list\n    property alias testOther: otherList\n    property alias testOtherRow: otherRow\n    property alias testUndo: undoButton\n    property alias testScroll: threadList', 1)
        component = QQmlComponent(self.engine)
        component.setData(source.encode(), QUrl.fromLocalFile(directory + '/components/EmailPopup.qml'))
        self.components.append(component)
        popup = component.create()
        self.assertIsNotNone(popup, '\n'.join(e.toString() for e in component.errors()))
        self.engine.rootContext().setContextProperty('popup', popup)
        window = QQuickWindow()
        window.resize(340, 800)
        popup.setParentItem(window.contentItem())
        window.show()
        QTest.qWait(30)

        def close():
            window.close()
            popup.setParentItem(None)
            popup.deleteLater()
            window.deleteLater()
            self.engine.rootContext().setContextProperty('popup', None)
        self.addCleanup(close)
        return popup, window

    def test_complete_popup_events_and_dynamic_preload(self):
        self.js('''
            var row=sut.rowOf({id:"t"},{messages:[{id:"m",internalDate:10,labelIds:["UNREAD"]}]});
            sut.bodies={m:"Hello https://example.com\\nsecond line" + "\\nbody line".repeat(30)};
            sut.threads=[row]; sut.total=1; sut.loaded=true;
        ''')
        popup, window = self.build_popup()
        def items(parent):
            for child in parent.childItems():
                yield child
                yield from items(child)
        self.assertFalse([child for child in items(popup) if child.metaObject().className().startswith('QQuickTextEdit')], 'Collapsed mail eagerly built text controls')
        # Keep the Wayland surface size fixed while the drawn rows unfold.
        reserved = popup.property('reserveHeight')
        sizes = []
        popup.implicitHeightChanged.connect(lambda: sizes.append(popup.implicitHeight()))
        row = self.js('return popup.testList.itemAt(0);')
        heights = []
        row.heightChanged.connect(lambda: heights.append(row.height()))
        popup.setProperty('expanded', 't')
        QTest.qWait(400)
        self.assertGreater(len(heights), 3)
        self.assertEqual(heights, sorted(heights))
        self.assertFalse(sizes, 'Popup window resized during expansion: ' + str(sizes))
        self.assertEqual(popup.property('reserveHeight'), reserved)
        heights.clear()
        popup.setProperty('expanded', '')
        QTest.qWait(400)
        self.assertGreater(len(heights), 3)
        self.assertEqual(heights, sorted(heights, reverse=True))
        self.assertFalse(sizes, 'Popup window resized during collapse: ' + str(sizes))
        self.assertFalse([child for child in items(popup) if child.metaObject().className().startswith('QQuickTextEdit')], 'Closed mail retained text controls after its fold')
        popup.setProperty('expanded', 't')
        QTest.qWait(100)
        popup.setProperty('expanded', '')
        QTest.qWait(100)
        popup.setProperty('expanded', 't')
        QTest.qWait(400)
        self.assertFalse(sizes, 'Popup window resized when reversing the animation: ' + str(sizes))
        editors = [child for child in items(popup) if child.metaObject().className().startswith('QQuickTextEdit')]
        self.assertEqual(len(editors), 1)
        editor = editors[0]
        point = editor.mapToScene(QPointF(1, 8)).toPoint()
        QTest.mouseMove(window, point)
        QTest.mousePress(window, Qt.LeftButton, Qt.NoModifier, point)
        QTest.mouseMove(window, point + QPoint(32, 0), 20)
        QTest.mouseRelease(window, Qt.LeftButton, Qt.NoModifier, point + QPoint(32, 0))
        self.assertTrue(editor.property('selectedText'))
        self.assertEqual(popup.property('expanded'), 't')
        QTest.mouseClick(window, Qt.RightButton, Qt.NoModifier, point)
        self.assertTrue(APP.clipboard().text())
        self.assertEqual(popup.property('expanded'), 't')
        self.js('popup.expanded=""; sut.threads=[sut.rowOf({id:"replacement"},{messages:[{id:"new",internalDate:20,labelIds:["UNREAD"]}]})];')
        self.check('sut.requests.length === 1 && sut.requests[0].url.includes("messages/new?")')
        self.js('''
            sut.reply({payload:{mimeType:"text/plain",body:{data:"SGVsbG8"}}});
            var cache={}, bodies={};
            for (var i=0; i<40; i++) {
                const row=sut.rowOf({id:"t"+i},{messages:[{id:"m"+i,internalDate:40-i,labelIds:["UNREAD"]}]});
                if (i<12) cache[row.id]={historyId:"1",row:row};
                bodies["m"+i]=i < 2 ? "body line\\n".repeat(30) : "Hello";
            }
            sut.bodies=bodies; sut.cache=cache;
            sut.threads=Object.values(cache).map(t=>t.row); sut.total=40;
        ''')
        QTest.qWait(20)
        self.check('popup.testList.count === 8 && popup.testMore.visible')
        sizes.clear()
        popup.setProperty('expanded', 't0')
        QTest.qWait(400)
        popup.setProperty('expanded', 't1')
        QTest.qWait(400)
        popup.setProperty('expanded', '')
        QTest.qWait(400)
        self.assertFalse(sizes, 'Popup window resized when switching mails: ' + str(sizes))
        for count in (16,24,32,40):
            # The button closes the list, under the rows, so scroll to it.
            self.js('popup.testScroll.contentY = Math.max(0, popup.testScroll.contentHeight - popup.testScroll.height);')
            QTest.qWait(5)
            more=next(item for item in items(popup) if item.objectName() == 'emailMore')
            point=more.mapToScene(QPointF(20,more.height()/2)).toPoint()
            QTest.mouseMove(window,point)
            QTest.mouseClick(window,Qt.LeftButton,Qt.NoModifier,point)
            self.assertEqual(popup.property('cap'),count)
            self.js('''
                if (sut.requests.length) {
                    const listed=Array.from({length:40},(_,i)=>({id:"t"+i,historyId:"1"}));
                    sut.lists(listed);
                    while (sut.requests.length) {
                        const id=sut.requests[0].url.match(/threads\\/t(\\d+)/)[1];
                        sut.reply({messages:[{id:"m"+id,internalDate:40-Number(id),labelIds:["UNREAD"]}]});
                    }
                }
            ''')
            QTest.qWait(5)
            self.check('popup.testList.count === '+str(count))
            self.check('popup.testScroll.height <= popup.listMax')
        self.check('!popup.testMore.visible && popup.testScroll.contentHeight > popup.testScroll.height')
        self.js('popup.testScroll.contentY=popup.testScroll.contentHeight-popup.testScroll.height;')
        self.check('popup.testScroll.contentY > 0')
        self.js('popup.markRead(sut.threads[0]);')
        self.check('OpenPopup.shown && sut.total === 39')
        self.js('''
            var last=sut.threads[0];
            sut.threads=[last]; sut.total=1;
            popup.markRead(last);
        ''')
        self.check('!OpenPopup.shown && sut.total === 0')

    def test_monogram_letters_and_tone(self):
        self.check('sut.initials("Ann Example") === "AE"')
        self.check('sut.initials("ann@example.com") === "A"')
        self.check('sut.initials("Γιώργος Παπαδόπουλος") === "ΓΠ"')
        self.check('sut.initials("| Example Ltd") === "EL"')
        self.check('sut.initials("") === ""')
        self.check('sut.addressOf("Ann <Ann@Example.com>") === "ann@example.com" && sut.addressOf("b@x.io") === "b@x.io"')
        self.check('sut.toneOf("ann@example.com", 8) === sut.toneOf("ann@example.com", 8) && sut.toneOf("ann@example.com", 8) < 8')
        self.check('new Set(["a@x","b@x","c@x","d@x","e@x","f@x"].map(a => sut.toneOf(a, 8))).size > 2')

    def mail_rows(self, ids, other=()):
        made = lambda id, at: 'sut.rowOf({id:"%s"},{messages:[{id:"m%s",internalDate:%d,labelIds:["UNREAD"],payload:{headers:[{name:"From",value:"%s Sender <%s@example.com>"},{name:"Subject",value:"About %s"}]}}]})' % (id, id, at, id.upper(), id, id)
        self.js('''
            sut.threads=[%s]; sut.total=%d; sut.otherThreads=[%s]; sut.other=%d; sut.loaded=true;
            sut.bodies={}; for (const t of sut.threads.concat(sut.otherThreads)) sut.bodies["m"+t.id] = "Body of " + t.id;
        ''' % (','.join(made(i, 100 - n) for n, i in enumerate(ids)), len(ids),
               ','.join(made(i, 50 - n) for n, i in enumerate(other)), len(other)))

    def items(self, parent):
        for child in parent.childItems():
            yield child
            yield from self.items(child)

    def button(self, parent, name):
        found = [c for c in self.items(parent) if c.property('name') == name and c.property('glyph') is not None]
        self.assertTrue(found, 'no %s button' % name)
        return found[0]

    def click(self, window, item):
        # A frame first, so the Column has laid out what just changed.
        QTest.qWait(40)
        point = item.mapToScene(QPointF(item.width() / 2, item.height() / 2)).toPoint()
        QTest.mouseMove(window, point)
        QTest.mouseClick(window, Qt.LeftButton, Qt.NoModifier, point)
        QTest.qWait(10)

    def test_popup_rows_carry_three_verbs(self):
        self.mail_rows(['a', 'b'])
        popup, window = self.build_popup(fold_ms=0)
        QTest.mouseMove(window, QPoint(330, 790))
        for i in range(2):
            row = self.js('return popup.testList.itemAt(%d);' % i)
            names = sorted(c.property('name') for c in self.items(row) if c.property('glyph') is not None and c.property('name') in ('Archive', 'Mark read', 'Star', 'Unstar'))
            self.assertEqual(names, ['Archive', 'Mark read', 'Star'])
        # Out of sight on a row the pointer is not on, out on the open one.
        self.check('!popup.testList.itemAt(0).showVerbs')
        self.js('popup.expanded = "a";')
        self.check('popup.testList.itemAt(0).showVerbs')
        self.js('sut.act("star", sut.threads[1]); sut.undoMs = 60000;')
        row = self.js('return popup.testList.itemAt(1);')
        self.button(row, 'Unstar')

    def test_acting_on_the_open_mail_opens_the_next_and_undo_reopens_it(self):
        self.mail_rows(['a', 'b', 'c'])
        popup, window = self.build_popup(fold_ms=0)
        self.js('popup.expanded = "b";')
        QTest.qWait(10)
        self.click(window, self.button(self.js('return popup.testList.itemAt(1);'), 'Archive'))
        self.check('sut.threads.map(t => t.id).join() === "a,c" && popup.expanded === "c"')
        self.check('sut.pending.length === 1 && popup.testUndo.visible && sut.requests.length === 0')
        self.click(window, self.button(popup, 'Undo: Archived'))
        self.check('sut.threads.map(t => t.id).join() === "a,b,c" && popup.expanded === "b" && sut.pending.length === 0')
        # The last one opens the one above instead.
        self.js('popup.expanded = "c";')
        QTest.qWait(10)
        self.click(window, self.button(self.js('return popup.testList.itemAt(2);'), 'Mark read'))
        self.check('popup.expanded === "b" && sut.threads.length === 2')
        # A star leaves the open mail open.
        self.click(window, self.button(self.js('return popup.testList.itemAt(1);'), 'Star'))
        self.check('popup.expanded === "b" && sut.threads[1].starred')

    def test_undo_button_keeps_the_window_still(self):
        self.mail_rows(['a', 'b'])
        popup, window = self.build_popup(fold_ms=0)
        reserved = popup.property('reserveHeight')
        self.js('sut.act("star", sut.threads[0]);')
        QTest.qWait(10)
        self.check('popup.testUndo.visible')
        self.assertEqual(popup.property('reserveHeight'), reserved)
        self.js('sut.undo();')
        QTest.qWait(10)
        self.check('!popup.testUndo.visible')
        self.assertEqual(popup.property('reserveHeight'), reserved)

    def test_closing_the_popup_sends_what_waits(self):
        self.mail_rows(['a', 'b'])
        popup, window = self.build_popup(fold_ms=0)
        self.js('popup.act("archive", sut.threads[0]); popup.act("star", sut.threads[0]);')
        self.check('sut.pending.length === 2 && sut.requests.length === 0')
        self.js('popup.visible = false;')
        self.check('sut.pending.length === 0 && sut.requests.length === 2')

    def test_last_mail_gone_closes_the_popup(self):
        self.mail_rows(['a'], other=['x'])
        popup, window = self.build_popup(fold_ms=0)
        self.js('popup.act("archive", sut.threads[0]);')
        self.check('!OpenPopup.shown')

    def test_other_row_unfolds_into_rows_with_the_same_verbs(self):
        self.mail_rows(['a'], other=['x', 'y'])
        popup, window = self.build_popup(fold_ms=0)
        self.check('popup.testOtherRow.visible && popup.testOther.count === 0 && !sut.otherWanted')
        self.click(window, self.js('return popup.testOtherRow;'))
        self.check('popup.otherOpen && sut.otherWanted && popup.testOther.count === 2')
        self.click(window, self.button(self.js('return popup.testOther.itemAt(0);'), 'Archive'))
        self.check('sut.other === 1 && sut.total === 1 && popup.testOther.count === 1 && OpenPopup.shown')
        self.click(window, self.button(popup, 'Undo: Archived'))
        self.check('sut.other === 2 && popup.testOther.count === 2')
        self.js('popup.visible = false;')
        self.check('!popup.otherOpen && !sut.otherWanted')

    def wheel(self, window, item, deltas, end=True):
        """A touchpad gesture over `item`: begin, one update per delta, end."""
        local = QPointF(item.width() / 2, 8)
        scene = item.mapToScene(local)
        QTest.mouseMove(window, scene.toPoint())
        def send(dx, dy, phase):
            event = QWheelEvent(scene, QPointF(window.mapToGlobal(scene.toPoint())), QPoint(dx, dy), QPoint(dx, dy),
                                Qt.NoButton, Qt.NoModifier, phase, False)
            QGuiApplication.sendEvent(window, event)
        send(0, 0, Qt.ScrollBegin)
        for dx, dy in deltas:
            send(dx, dy, Qt.ScrollUpdate)
            QTest.qWait(5)
        if end:
            send(0, 0, Qt.ScrollEnd)

    def test_swipe_left_past_the_reach_archives(self):
        self.mail_rows(['a', 'b'])
        popup, window = self.build_popup(fold_ms=0)
        QTest.qWait(40)
        row = self.js('return popup.testList.itemAt(0);')
        self.wheel(window, row, [(-40, 0)] * 4)
        QTest.qWait(30)
        self.check('sut.pending.length === 0 && sut.threads.length === 2')
        QTest.qWait(300)
        self.check('sut.pending.length === 1 && sut.pending[0].kind === "archive" && sut.pending[0].row.id === "a"')
        self.check('sut.threads.map(t => t.id).join() === "b"')

    def test_short_swipe_springs_back(self):
        self.mail_rows(['a'])
        popup, window = self.build_popup(fold_ms=0)
        QTest.qWait(40)
        row = self.js('return popup.testList.itemAt(0);')
        self.wheel(window, row, [(30, 0)] * 2)
        self.check('popup.testList.itemAt(0).swipe === 60 || popup.testList.itemAt(0).swipe < 60')
        QTest.qWait(1500)
        self.check('Math.abs(popup.testList.itemAt(0).swipe) < 1 && sut.pending.length === 0 && sut.threads.length === 1')

    def test_a_scroll_never_turns_into_a_swipe(self):
        self.mail_rows(['a'])
        popup, window = self.build_popup(fold_ms=0)
        QTest.qWait(40)
        row = self.js('return popup.testList.itemAt(0);')
        self.wheel(window, row, [(0, -10)] + [(-60, -2)] * 4)
        QTest.qWait(400)
        self.check('popup.testList.itemAt(0).swipe === 0 && sut.pending.length === 0')

    def test_a_swipe_that_never_ends_lets_go_when_quiet(self):
        self.mail_rows(['a', 'b'])
        popup, window = self.build_popup(fold_ms=0)
        QTest.qWait(40)
        row = self.js('return popup.testList.itemAt(0);')
        self.wheel(window, row, [(50, 0)] * 4, end=False)
        QTest.qWait(500)
        self.check('sut.pending.length === 1 && sut.pending[0].kind === "read"')

    def test_mouse_drag_right_marks_read(self):
        self.mail_rows(['a', 'b'])
        popup, window = self.build_popup(fold_ms=0)
        QTest.qWait(40)
        row = self.js('return popup.testList.itemAt(1);')
        start = row.mapToScene(QPointF(80, 8)).toPoint()
        QTest.mousePress(window, Qt.LeftButton, Qt.NoModifier, start)
        for step in range(1, 9):
            QTest.mouseMove(window, start + QPoint(step * 25, 0), 10)
        QTest.mouseRelease(window, Qt.LeftButton, Qt.NoModifier, start + QPoint(200, 0))
        QTest.qWait(300)
        self.check('sut.pending.length === 1 && sut.pending[0].kind === "read" && sut.pending[0].row.id === "b"')
        self.check('popup.expanded === ""')

    # --- codes and cards -----------------------------------------------------

    def code(self, text):
        return self.js('return sut.codeOf(' + json.dumps(text) + ');')

    def test_codes_are_found(self):
        cases = {
            'Your verification code is 123456': '123456',
            '123456 is your Google verification code': '123456',
            'G-482913 is your Google verification code.': '482913',
            'Use 482 913 to sign in. This is your one-time code.': '482913',
            'Enter 482-913 when asked; your passcode expires soon': '482913',
            'Κωδικός επαλήθευσης: 7731': '7731',
            'Ο κωδικός σας είναι 55120.': '55120',
            'Your PIN: 0420': '0420',
            'OTP 99887766 valid for 10 minutes': '99887766',
            'Sign-in code\n314159 — it expires in 10 minutes': '314159',
        }
        for text, expected in cases.items():
            with self.subTest(text=text):
                self.assertEqual(self.code(text), expected)

    def test_near_misses_are_not_codes(self):
        cases = [
            'Your code of conduct for 2026',
            'Order 123456 has shipped',
            'Promo code inside! Order #554433, total $1299',
            'Use the code at checkout for €1500 off',
            'Use the code at checkout for 1500€ off',
            'PIN reminder: meeting at 12:30 on 15/10/2026',
            'Invoice no. 20231105 needs verification',
            'Your code: SAVE20',
            'Call 2101234567 for your code',
            'Ref 445566: verification pending',
            'Discount code: 25% off 4 items',
            'Your code is below.' + ' Lorem ipsum dolor sit amet.' * 5 + ' 123456',
            'No keyword here at all: 123456',
            'barcode 123456',
            'Price 1.234,56 with your pin',
        ]
        for text in cases:
            with self.subTest(text=text):
                self.assertEqual(self.code(text), '')

    def test_rows_carry_their_code(self):
        self.js('''
            var row = sut.rowOf({id:"t", snippet:"Enter 778899 to continue"}, {messages:[{id:"m",internalDate:"1",labelIds:["UNREAD"],payload:{headers:[{name:"Subject",value:"Your sign-in code"}]}}]});
            sut.found = row;
        ''')
        self.check('sut.found.code === "778899" && sut.codeIn(sut.found) === "778899"')
        self.js('sut.found = sut.rowOf({id:"u", snippet:"Hello"}, {messages:[{id:"n",internalDate:"1",labelIds:["UNREAD"]}]});')
        self.check('sut.found.code === "" && sut.codeIn(sut.found) === ""')
        self.js('sut.bodies = {n: "Your verification code is 246810"};')
        self.check('sut.codeIn(sut.found) === "246810"')

    def row_at(self, id, at, subject='Hello'):
        return 'sut.rowOf({id:"%s", snippet:"snip"},{messages:[{id:"m%s",internalDate:"%d",labelIds:["UNREAD"],payload:{headers:[{name:"From",value:"Ann <ann@x.com>"},{name:"Subject",value:"%s"}]}}]})' % (id, id, at, subject)

    def test_first_poll_and_open_popup_send_no_cards(self):
        self.js('sut.announce([%s]);' % self.row_at('a', 10))
        self.check('sut.cards.length === 0')
        self.js('sut.popupOpen = true; sut.announce([%s, %s]);' % (self.row_at('b', 20), self.row_at('a', 10)))
        self.check('sut.cards.length === 0')
        # Seen while the popup was open is seen.
        self.js('sut.popupOpen = false; sut.announce([%s, %s]);' % (self.row_at('b', 20), self.row_at('a', 10)))
        self.check('sut.cards.length === 0')

    def test_an_empty_inbox_at_start_still_hears_the_first_mail(self):
        self.js('sut.announce([]); sut.announce([%s]);' % self.row_at('a', 10))
        self.check('sut.cards.length === 1')

    def test_one_card_per_new_mail_with_its_buttons(self):
        self.js('sut.announce([%s]);' % self.row_at('a', 10))
        self.js('sut.announce([%s, %s, %s]);' % (self.row_at('c', 30, 'Your code is 123456'), self.row_at('b', 20, 'Tom & <Jerry>'), self.row_at('a', 10)))
        self.check('sut.cards.length === 2')
        command = self.js('return JSON.stringify(sut.cards.map(c => c.command));')
        cards = json.loads(command)
        # Oldest first, so the newest ends on top.
        self.assertIn('--hint=string:x-gmail-thread:b', cards[0])
        self.assertIn('--hint=string:x-gmail-thread:c', cards[1])
        for c in cards:
            self.assertEqual(c[:2], ['notify-send', '--wait'])
            self.assertIn('--action=archive=Archive', c)
            self.assertIn('--action=read=Mark read', c)
            self.assertEqual(c[c.index('--') + 1], 'Ann')
        self.assertIn('--action=code=Copy 123456', cards[1])
        self.assertNotIn('--action=code=Copy 123456', cards[0])
        self.assertEqual(cards[0][-1], 'Tom &amp; &lt;Jerry&gt;\nsnip')

    def test_many_new_mails_are_one_card_and_older_rows_are_not_new(self):
        self.js('sut.announce([%s]);' % self.row_at('a', 10))
        rows = ', '.join(self.row_at('n%d' % i, 20 + i) for i in range(5))
        self.js('sut.announce([%s, %s]);' % (rows, self.row_at('a', 10)))
        cards = json.loads(self.js('return JSON.stringify(sut.cards.map(c => c.command));'))
        self.assertEqual(len(cards), 1)
        self.assertEqual(cards[0][-2:], ['5 new mails', ''])
        self.assertFalse([a for a in cards[0] if 'x-gmail-thread' in a])
        # "Load more" brings older rows into the list; they are not news.
        self.js('sut.announce([%s, %s, %s]);' % (rows, self.row_at('a', 10), self.row_at('old', 5)))
        self.check('sut.cards.length === 1')

    def test_card_answers_act_at_once(self):
        self.seed(['a', 'b'])
        self.js('sut.answered("archive", sut.threads[0], "");')
        self.check('sut.pending.length === 0 && sut.requests.length === 1 && sut.requests[0].body.removeLabelIds.includes("INBOX")')
        self.check('sut.threads.map(t => t.id).join() === "b"')
        self.js('sut.answered("code", sut.threads[0], "123456");')
        self.check('sut.copied === "123456" && sut.requests.length === 2 && sut.threads.length === 0')
        self.js('sut.answered("default", null, "");')
        self.check('sut.summons === 1')
        self.js('sut.answered("", null, ""); sut.answered("", {id:"x"}, "");')
        self.check('sut.summons === 1 && sut.requests.length === 2')

    def test_dealing_with_a_mail_withdraws_its_card(self):
        self.seed(['a', 'b'])
        self.js('sut.act("archive", sut.threads[0]); sut.markRead(sut.threads[0]);')
        self.check('Notifications.withdrawn.join() === "x-gmail-thread=a,x-gmail-thread=b"')

    # --- the open mail's foot -------------------------------------------------

    def test_attachments_leave_out_images_placed_in_the_text(self):
        payload = {'mimeType': 'multipart/mixed', 'parts': [
            {'mimeType': 'multipart/related', 'parts': [
                {'mimeType': 'text/html', 'body': {'data': encoded('<p>Hi</p>')}},
                {'mimeType': 'image/png', 'filename': 'logo.png', 'body': {'attachmentId': 'logo', 'size': 900},
                 'headers': [{'name': 'Content-ID', 'value': '<logo@x>'}, {'name': 'Content-Disposition', 'value': 'inline; filename="logo.png"'}]},
            ]},
            {'mimeType': 'application/pdf', 'filename': 'report.pdf', 'body': {'attachmentId': 'pdf', 'size': 245760},
             'headers': [{'name': 'Content-Disposition', 'value': 'attachment; filename="report.pdf"'}]},
            # A picture sent inline but with no Content-ID is still a file.
            {'mimeType': 'image/jpeg', 'filename': 'photo.jpg', 'body': {'attachmentId': 'jpg', 'size': 3 * 1048576},
             'headers': [{'name': 'Content-Disposition', 'value': 'inline'}]},
            {'mimeType': 'text/plain', 'body': {'data': encoded('no file')}},
        ]}
        parts = json.loads(self.js('return JSON.stringify(sut.partsOf(' + json.dumps(payload) + '));'))
        self.assertEqual([p['name'] for p in parts], ['report.pdf', 'photo.jpg'])
        self.assertEqual(parts[0], {'id': 'pdf', 'name': 'report.pdf', 'size': 245760, 'type': 'application/pdf'})
        self.check('sut.partsOf(null).length === 0')
        self.check('sut.sayFile({name:"report.pdf", size:245760}) === "report.pdf · 240 KB"')
        self.check('sut.sayFile({name:"a.txt", size:12}) === "a.txt · 12 B"')
        self.check('sut.sayFile({name:"photo.jpg", size:3*1048576}) === "photo.jpg · 3.0 MB"')
        self.check('sut.sayFile({name:"a-very-long-file-name-from-the-scanner.pdf", size:2048}) === "a-very-long-file-n…nner.pdf · 2 KB"')

    def test_body_read_collects_the_files(self):
        self.js('''
            sut.read({messages:[{id:"m",snippet:"s"}]});
            sut.reply({payload:{mimeType:"multipart/mixed",parts:[
                {mimeType:"text/plain",body:{data:"SGVsbG8"}},
                {mimeType:"application/pdf",filename:"a.pdf",body:{attachmentId:"x",size:10}}]}});
        ''')
        self.check('sut.files.m.length === 1 && sut.files.m[0].name === "a.pdf" && sut.bodies.m === "Hello"')
        self.js('sut.read({messages:[{id:"n",snippet:"s"}]}); sut.reply({payload:{mimeType:"text/plain",body:{data:"SGVsbG8"}}});')
        self.check('sut.files.n === undefined')

    def test_unsubscribe_header_shapes(self):
        cases = [
            ('<mailto:leave@list.example>, <https://list.example/u?id=1>', 'List-Unsubscribe=One-Click', {'url': 'https://list.example/u?id=1', 'oneClick': True}),
            ('<https://list.example/u?id=1>', '', {'url': 'https://list.example/u?id=1', 'oneClick': False}),
            ('<https://a.example/u>,\r\n <https://b.example/u>', 'list-unsubscribe = one-click', {'url': 'https://a.example/u', 'oneClick': True}),
            ('< https://list.example/u >', '', {'url': 'https://list.example/u', 'oneClick': False}),
            ('<mailto:leave@list.example?subject=unsubscribe>', 'List-Unsubscribe=One-Click', None),
            ('<http://list.example/u>', '', None),
            ('https://list.example/u', '', None),
            ('', '', None),
        ]
        for header, post, expected in cases:
            with self.subTest(header=header):
                got = json.loads(self.js('return JSON.stringify(sut.unsubscribeOf(%s, %s));' % (json.dumps(header), json.dumps(post))))
                self.assertEqual(got, expected)

    def test_rows_read_their_unsubscribe_headers(self):
        self.check('sut.headersUrl("t").includes("metadataHeaders=List-Unsubscribe&metadataHeaders=List-Unsubscribe-Post")')
        self.js('''sut.found = sut.rowOf({id:"t"}, {messages:[{id:"m",internalDate:"1",labelIds:["UNREAD"],payload:{headers:[
            {name:"List-Unsubscribe",value:"<https://shop.example/u>"},{name:"List-Unsubscribe-Post",value:"List-Unsubscribe=One-Click"}]}}]});''')
        self.check('sut.found.unsubscribe.url === "https://shop.example/u" && sut.found.unsubscribe.oneClick')

    def test_mail_to_task_waits_with_its_archive(self):
        tasks = self.create('import QtQuick\nQtObject { property var added: []; function add(title, day, list, notes) { added = added.concat([[title, day, list, notes]]); } }')
        self.engine.rootContext().setContextProperty('Tasks', tasks)
        self.addCleanup(self.engine.rootContext().setContextProperty, 'Tasks', None)
        self.seed(['a'])
        self.js('sut.threads = [Object.assign({}, sut.threads[0], {from: "Ann", address: "ann@x.com", subject: "Lunch?"})];')
        self.js('sut.act("archive", sut.threads[0], {said: "Task made", also: sut.makeTask}); sut.undo(); sut.flush();')
        self.check('Tasks.added.length === 0 && sut.requests.length === 0')
        self.js('sut.act("archive", sut.threads[0], {said: "Task made", also: sut.makeTask}); sut.flush();')
        self.check('Tasks.added.length === 1 && sut.requests.length === 1')
        self.check('JSON.stringify(Tasks.added[0]) === JSON.stringify(["Lunch?", "", "", "Ann <ann@x.com>\\n" + sut.web + "#all/a"])')

    def test_one_click_unsubscribe_posts_without_the_token(self):
        http = self.create('import QtQuick\nQtObject { property var sent: []; function request(method, url, body, headers, timeout, ok, failed) { sent = sent.concat([{method: method, url: url, body: body, headers: headers}]); ok({status: 200}); } }')
        self.engine.rootContext().setContextProperty('Http', http)
        self.addCleanup(self.engine.rootContext().setContextProperty, 'Http', None)
        self.seed(['a'])
        self.js('sut.threads = [Object.assign({}, sut.threads[0], {unsubscribe: {url: "https://shop.example/u", oneClick: true}})];')
        self.js('sut.act("archive", sut.threads[0], {said: "Unsubscribed", also: sut.unsubscribe});')
        self.check('Http.sent.length === 0')
        self.js('sut.flush();')
        self.check('Http.sent.length === 1 && Http.sent[0].method === "POST" && Http.sent[0].url === "https://shop.example/u"')
        self.check('Http.sent[0].body === "List-Unsubscribe=One-Click" && Object.keys(Http.sent[0].headers).join() === "Content-Type"')
        self.check('sut.requests.length === 1 && sut.trouble === ""')

    def test_open_mail_foot_offers_what_the_mail_allows(self):
        self.mail_rows(['a', 'b'])
        self.js('''
            sut.threads = [Object.assign({}, sut.threads[0], {unsubscribe: {url: "https://shop.example/u", oneClick: true}}), sut.threads[1]];
            sut.files = {ma: [{id: "x", name: "report.pdf", size: 2048, type: "application/pdf"}]};
        ''')
        popup, window = self.build_popup(fold_ms=0)
        self.js('popup.expanded = "a";')
        QTest.qWait(40)
        row = self.js('return popup.testList.itemAt(0);')
        unsubscribe = self.button(row, 'Unsubscribe')
        self.assertTrue(unsubscribe.isVisible())
        self.button(row, 'Save report.pdf')
        self.click(window, self.button(row, 'Make a task'))
        self.check('sut.pending.length === 1 && sut.pending[0].said === "Task made" && sut.pending[0].also === sut.makeTask')
        self.check('popup.expanded === "b"')
        row = self.js('return popup.testList.itemAt(0);')
        self.assertFalse(self.button(row, 'Unsubscribe').isVisible())

    def test_real_text_control_selection_copy_and_links(self):
        # Keep the real popup control; intercept the external browser boundary.
        body = BODY.replace('Qt.openUrlExternally(url);', 'link.activated = url;')
        ui = self.create('''import QtQuick
            Item {
                id: link; width: 320; height: 240
                property string activated: ""
                property var fetched: "Hello https://example.com?a=1&b=2\\nsecond line"
                property var modelData: ({snippet:"fallback"})
                property alias editor: messageText
            ''' + body + '\n}', directory=Path(tempfile.gettempdir()))
        self.engine.rootContext().setContextProperty('ui', ui)
        window = QQuickWindow()
        window.resize(320, 240)
        ui.setParentItem(window.contentItem())
        window.show()
        QTest.qWait(30)
        self.check('ui.editor.getText(0,ui.editor.length).replace(/\\u2028/g,"\\n") === ui.fetched')
        self.check('ui.editor.readOnly && ui.editor.selectByMouse')
        editor_item = ui.childItems()[0]
        quick_document = editor_item.property('textDocument')
        document = quick_document.textDocument()
        link_cursor = document.find('https://example.com')
        self.assertEqual(link_cursor.charFormat().foreground().color().name(), '#c0c0c0')
        QTest.mouseMove(window, QPoint(80, 8))
        QTest.qWait(5)
        self.assertEqual(window.cursor().shape(), Qt.PointingHandCursor)
        QTest.mouseMove(window, QPoint(5, 8))
        QTest.qWait(5)
        self.assertEqual(window.cursor().shape(), Qt.IBeamCursor)
        self.js('ui.editor.select(0,5);')
        QTest.mouseClick(window, Qt.RightButton, Qt.NoModifier, QPoint(10, 8))
        self.assertEqual(APP.clipboard().text(), 'Hello')
        self.js('ui.editor.deselect();')
        QTest.mouseClick(window, Qt.RightButton, Qt.NoModifier, QPoint(10, 8))
        self.assertEqual(APP.clipboard().text(), 'Hello https://example.com?a=1&b=2\nsecond line')
        self.js('ui.editor.deselect();')
        QTest.mousePress(window, Qt.LeftButton, Qt.NoModifier, QPoint(1, 8))
        QTest.mouseMove(window, QPoint(32, 8), 20)
        QTest.mouseRelease(window, Qt.LeftButton, Qt.NoModifier, QPoint(32, 8))
        self.check('ui.editor.selectedText.length > 0')
        self.check('OpenPopup.shown')
        self.js('ui.editor.deselect();')
        QTest.mouseClick(window, Qt.LeftButton, Qt.NoModifier, QPoint(80, 8))
        self.assertEqual(ui.property('activated'), 'https://example.com?a=1&b=2')
        self.check('!OpenPopup.shown')
        self.js('OpenPopup.shown=true;')
        self.js('ui.editor.linkActivated("file:///tmp/x");')
        self.assertEqual(ui.property('activated'), 'https://example.com?a=1&b=2')
        self.check('OpenPopup.shown')
        window.close()
        ui.setParentItem(None)
        ui.deleteLater()
        window.deleteLater()
        self.engine.rootContext().setContextProperty('ui', None)


if __name__ == '__main__':
    unittest.main(verbosity=2)
