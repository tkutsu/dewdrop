#!/usr/bin/env python3
"""Save one Gmail attachment to ~/Downloads and print where it went.

    GMAIL_TOKEN=... gmail-attachment MESSAGE_ID ATTACHMENT_ID FILENAME

The mail popup runs this when an attachment chip is clicked (services/Email.qml)
and opens the printed path. The access token comes in the environment, never as
an argument, so it does not show in the process list. The file name is the
sender's choice, so it is made safe before it touches the disk, and a name
already taken in the folder gets a number rather than being overwritten.
"""

import base64
import json
import os
from pathlib import Path
import sys
import urllib.error
import urllib.parse
import urllib.request

API = "https://gmail.googleapis.com/gmail/v1/users/me"


def safe_name(name):
    """No directories, no hidden files, no control characters, never empty."""
    name = "".join(c for c in name if c >= " " and c != "\x7f")
    name = name.replace("/", "_").replace("\\", "_")
    name = name.strip().lstrip(".").strip()
    if len(name.encode()) > 200:
        stem, suffix = os.path.splitext(name)
        while stem and len((stem + suffix).encode()) > 200:
            stem = stem[:-1]
        name = (stem + suffix).encode()[:200].decode("utf-8", errors="ignore").lstrip(".")
    return name or "attachment"


def write_new(folder, name, data):
    """Write to `name` in `folder`, or to "name (2).ext" and on if it is taken."""
    stem, suffix = os.path.splitext(name)
    n = 1
    while True:
        path = folder / (name if n == 1 else f"{stem} ({n}){suffix}")
        try:
            with open(path, "xb") as out:
                out.write(data)
            return path
        except FileExistsError:
            n += 1


def fetch(token, message, attachment):
    url = f"{API}/messages/{urllib.parse.quote(message, safe='')}/attachments/{urllib.parse.quote(attachment, safe='')}?fields=data"
    request = urllib.request.Request(url, headers={"Authorization": "Bearer " + token})
    with urllib.request.urlopen(request, timeout=120) as reply:
        data = json.load(reply)["data"]
    return base64.urlsafe_b64decode(data + "=" * (-len(data) % 4))


def main(argv):
    if len(argv) != 4:
        print(__doc__.strip().splitlines()[2].strip(), file=sys.stderr)
        return 2
    token = os.environ.get("GMAIL_TOKEN", "")
    if not token:
        print("no GMAIL_TOKEN in the environment", file=sys.stderr)
        return 2
    _, message, attachment, name = argv
    try:
        data = fetch(token, message, attachment)
    except urllib.error.HTTPError as error:
        print(f"Google said {error.code}", file=sys.stderr)
        return 1
    except (urllib.error.URLError, TimeoutError) as error:
        print(f"no network: {error}", file=sys.stderr)
        return 1
    folder = Path.home() / "Downloads"
    folder.mkdir(parents=True, exist_ok=True)
    print(write_new(folder, safe_name(name), data))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
