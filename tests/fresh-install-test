#!/usr/bin/python3 -I
"""Boot a fresh Arch in a VM, install dewdrop the way the README says, and look.

    tests/fresh-install-test [--gl] [--keep] [--minutes N]

The VM is the official Arch cloud image under KVM, a throwaway copy each run.
cloud-init installs Hyprland, Quickshell and the README's base requirements and
nothing else (plus foot, so a terminal is found),
unpacks this checkout's tracked files as ~/.config/quickshell, and logs in on
tty1 straight into Hyprland with a hyprland.lua that loads hypr/dewdrop.lua and
starts qs. A minute later QEMU takes a screenshot, the guest sends back the
bar's log and what Hyprland has open, and powers off.

Results land in ~/.cache/dewdrop-fresh-test/runs/<time>/: screen.png, qs.log,
qs.stderr, hyprland.log, layers.txt, install.log, console.log. The summary at
the end lists the log's errors; it fails on the ones that stop QML loading, not
on Quickshell saying an optional service (NetworkManager, UPower) is absent.

--gl gives the guest a virgl GPU drawn through the host's EGL; without it the
guest renders in software, which is slower but needs nothing from the host GPU.
--keep leaves the VM's disk for another look. The base image (~600 MB) is
downloaded once; packages are downloaded every run.

Needs qemu-system-x86_64, qemu-img, curl and /dev/kvm.
"""

import argparse
import datetime
import http.server
import io
import os
import re
import shutil
import socket
import subprocess
import sys
import tarfile
import threading
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "dewdrop-fresh-test"
IMAGE_URL = "https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2"

# The README's "What it needs", by Arch package, and what the test itself uses.
PACKAGES = [
    "hyprland", "quickshell", "pipewire", "pipewire-pulse", "wireplumber", "libpulse", "libnotify", "xdg-utils",
    "imagemagick", "coreutils", "ttf-nerd-fonts-symbols", "inter-font", "ttf-iosevkaterm-nerd",
    "foot",
]

HYPRLAND = """\
dofile(os.getenv("HOME") .. "/.config/quickshell/hypr/dewdrop.lua")

hl.config({ general = { gaps_out = 8 } })

hl.on("hyprland.start", function()
\thl.exec_cmd("sh -c 'qs > /tmp/out/qs.stderr 2>&1'")
\thl.exec_cmd("sh -c '~/look > /tmp/out/look.log 2>&1'")
end)
"""

# Run inside the session, once the bar has had a minute to settle. Each
# thing goes back as soon as it is there, so one that hangs loses only itself.
LOOK = """\
#!/bin/sh
sleep {settle}
cd /tmp/out
curl -s -T /dev/null "http://10.0.2.2:{port}/shoot/screen"
send() {{ curl -s -T "$1" "http://10.0.2.2:{port}/results/$1"; }}
timeout 20 env NO_COLOR=1 qs log > qs.log 2>&1; send qs.log
hyprctl layers > layers.txt 2>&1; send layers.txt
cp "$XDG_RUNTIME_DIR"/hypr/*/hyprland.log . 2>/dev/null; send hyprland.log
send qs.stderr
send look.log
curl -s -T /dev/null "http://10.0.2.2:{port}/results/done"
sudo poweroff
"""

# The look's stand-in, run as root, for when the session never got that far:
# Hyprland's own log, the boot's journal and the GPU the guest was given.
FALLBACK = """\
#!/bin/sh
mkdir -p /tmp/diag && cd /tmp/diag
cp /tmp/out/* . 2>/dev/null
cp /run/user/1000/hypr/*/hyprland.log . 2>/dev/null || cp /home/dew/hyprland.log . 2>/dev/null
journalctl -b --no-pager > journal.txt 2>&1
ls -la /dev/dri > dri.txt 2>&1
for f in *; do curl -s -T "$f" "http://10.0.2.2:{port}/results/$f"; done
curl -s -T /dev/null "http://10.0.2.2:{port}/results/done"
"""

USER_DATA = """\
#cloud-config
users:
  - name: dew
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
write_files:
  - path: /etc/systemd/system/getty@tty1.service.d/autologin.conf
    content: |
      [Service]
      ExecStart=
      ExecStart=-/sbin/agetty -o '-p -f -- \\\\u' --noclear --autologin dew %I $TERM
  - path: /home/dew/.bash_profile
    defer: true
    content: |
      if [ "$(tty)" = /dev/tty1 ]; then
        mkdir -p /tmp/out
        if command -v start-hyprland >/dev/null; then exec start-hyprland >> ~/hyprland.log 2>&1; fi
        exec Hyprland >> ~/hyprland.log 2>&1
      fi
  - path: /home/dew/.config/hypr/hyprland.lua
    defer: true
    content: |
{hyprland}
  - path: /home/dew/look
    defer: true
    permissions: "0755"
    content: |
{look}
  - path: /root/fallback
    defer: true
    permissions: "0755"
    content: |
{fallback}
runcmd:
  - [sh, -c, "curl -s -T /dev/null http://10.0.2.2:{port}/status/installing"]
  - [sh, -c, "pacman -Syu --noconfirm --needed {packages} > /var/log/dewdrop-install.log 2>&1; curl -s -T /var/log/dewdrop-install.log http://10.0.2.2:{port}/results/install.log"]
  - [sh, -c, "mkdir -p /home/dew/.config/quickshell && curl -s http://10.0.2.2:{port}/dewdrop.tar.gz | tar -xz -C /home/dew/.config/quickshell"]
  - [chown, -R, "dew:dew", /home/dew]
  - [sh, -c, "curl -s -T /dev/null http://10.0.2.2:{port}/status/starting-hyprland"]
  - [systemd-run, "--on-active={fallback_after}", /root/fallback]
  - [systemctl, restart, getty@tty1]
"""


def indent(text: str, by: int) -> str:
    return "".join(" " * by + line + "\n" for line in text.splitlines())


def checkout_tarball() -> bytes:
    """The tracked files as they are on disk, edits and all, without .git."""
    names = subprocess.run(["git", "-C", str(REPO), "ls-files", "-z"], capture_output=True, check=True).stdout.split(b"\0")
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w:gz") as tar:
        for name in filter(None, names):
            path = REPO / name.decode()
            if path.exists():
                tar.add(path, arcname=name.decode(), recursive=False)
    return buffer.getvalue()


class Server(http.server.ThreadingHTTPServer):
    files: dict
    results: Path
    sock: Path
    done: threading.Event


class Handler(http.server.BaseHTTPRequestHandler):
    server: Server

    def log_message(self, *args):
        pass

    def do_GET(self):
        body = self.server.files.get(self.path.lstrip("/"))
        if body is None:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_PUT(self):
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length)
        kind, _, name = self.path.lstrip("/").partition("/")
        name = Path(name).name
        if kind == "status":
            print(f"  guest: {name}", flush=True)
        elif kind == "shoot":
            # Answered once QEMU has it, so the guest waits for the picture.
            monitor(self.server.sock, f"screendump {self.server.results / 'screen.png'} -f png")
        elif kind == "results" and name == "done":
            self.server.done.set()
        elif kind == "results" and name:
            (self.server.results / name).write_bytes(body)
        self.send_response(201)
        self.send_header("Content-Length", "0")
        self.end_headers()


def base_image() -> Path:
    image = CACHE / "Arch-Linux-x86_64-cloudimg.qcow2"
    if not image.exists():
        print(f"Downloading the Arch cloud image to {image}", flush=True)
        CACHE.mkdir(parents=True, exist_ok=True)
        subprocess.run(["curl", "-fL", "-o", str(image) + ".part", IMAGE_URL], check=True)
        os.replace(str(image) + ".part", image)
    return image


def gpu(gl: bool) -> list:
    """The guest's screen. Arch's qemu-base has no virtio GPU (that is
    qemu-hw-display-virtio-vga and its -gpu packages), so without one the guest
    gets bochs-display, a plain framebuffer Mesa renders to in software."""
    devices = subprocess.run(["qemu-system-x86_64", "-device", "help"], capture_output=True, text=True).stdout
    if gl:
        if '"virtio-vga-gl"' not in devices:
            sys.exit("fresh-install-test: --gl needs qemu-hw-display-virtio-vga-gl and qemu-ui-egl-headless")
        return ["-device", "virtio-vga-gl", "-display", "egl-headless"]
    return ["-device", "virtio-vga" if '"virtio-vga"' in devices else "bochs-display", "-display", "none"]


def monitor(path: Path, command: str) -> None:
    try:
        with socket.socket(socket.AF_UNIX) as sock:
            sock.connect(str(path))
            sock.sendall(command.encode() + b"\n")
            time.sleep(1)
    except OSError:
        pass


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--gl", action="store_true", help="virgl through the host's EGL instead of software rendering")
    parser.add_argument("--keep", action="store_true", help="keep the VM's disk")
    parser.add_argument("--minutes", type=int, default=30, help="give up after this long (default 30)")
    parser.add_argument("--settle", type=int, default=60, help="seconds the bar runs before the look (default 60)")
    args = parser.parse_args()

    for tool in ("qemu-system-x86_64", "qemu-img", "curl"):
        if not shutil.which(tool):
            sys.exit(f"fresh-install-test: needs {tool}")
    if not os.access("/dev/kvm", os.R_OK | os.W_OK):
        sys.exit("fresh-install-test: needs read and write access to /dev/kvm")

    run = CACHE / "runs" / datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    run.mkdir(parents=True, exist_ok=True)
    disk = run / "disk.qcow2"
    subprocess.run(["qemu-img", "create", "-q", "-f", "qcow2", "-b", str(base_image()), "-F", "qcow2", str(disk), "20G"], check=True)

    server = Server(("127.0.0.1", 0), Handler)
    port = server.server_address[1]
    server.results = run
    server.done = threading.Event()
    server.sock = run / "monitor.sock"
    server.files = {
        "meta-data": b"instance-id: dewdrop-fresh\nlocal-hostname: dewdrop\n",
        "user-data": USER_DATA.format(
            port=port,
            packages=" ".join(PACKAGES),
            hyprland=indent(HYPRLAND, 6),
            look=indent(LOOK.format(port=port, settle=args.settle), 6),
            fallback=indent(FALLBACK.format(port=port), 6),
            fallback_after=args.settle + 180,
        ).encode(),
        "vendor-data": b"",
        "dewdrop.tar.gz": checkout_tarball(),
    }
    threading.Thread(target=server.serve_forever, daemon=True).start()

    sock = server.sock
    qemu = [
        "qemu-system-x86_64", "-machine", "q35,accel=kvm", "-cpu", "host", "-m", "4096", "-smp", "4",
        "-drive", f"if=virtio,file={disk}",
        "-nic", "user,model=virtio-net-pci",
        "-smbios", f"type=1,serial=ds=nocloud;s=http://10.0.2.2:{port}/",
        "-serial", f"file:{run / 'console.log'}",
        "-monitor", f"unix:{sock},server,nowait",
        *gpu(args.gl),
    ]
    print(f"Booting the VM; results in {run}", flush=True)
    vm = subprocess.Popen(qemu, stdout=subprocess.DEVNULL, stderr=open(run / "qemu.stderr", "w"))
    deadline = time.monotonic() + args.minutes * 60
    while vm.poll() is None and not server.done.is_set() and time.monotonic() < deadline:
        time.sleep(2)
    if vm.poll() is None:
        if not (run / "screen.png").exists():
            monitor(sock, f"screendump {run / 'screen.png'} -f png")
        if not server.done.is_set():
            print(f"Gave up after {args.minutes} minutes", flush=True)
        try:
            vm.wait(60)
        except subprocess.TimeoutExpired:
            monitor(sock, "quit")
            vm.wait(10)
    server.shutdown()
    if not args.keep:
        disk.unlink(missing_ok=True)

    # The summary: what came back, and the log's errors.
    print()
    for name in ("screen.png", "qs.log", "qs.stderr", "hyprland.log", "journal.txt", "install.log", "console.log"):
        path = run / name
        print(f"  {'ok  ' if path.exists() and path.stat().st_size else 'none'} {path}")
    log = "\n".join((run / name).read_text(errors="replace") for name in ("qs.log", "qs.stderr") if (run / name).exists())
    lines = {re.sub(r"\x1b\[[0-9;]*m", "", line).strip() for line in log.splitlines()}
    broken = sorted(line for line in lines if re.search(r"ReferenceError|TypeError|is not a function|Cannot read|unavailable|is not installed|Failed to load", line))
    other = sorted(line for line in lines if "ERROR" in line and line not in broken)
    print(f"\n{len(broken)} QML errors in the bar's log" + (":" if broken else "."))
    for line in broken[:40]:
        print("  " + line[:200])
    if other:
        print(f"{len(other)} other errors, usually an optional service that is not installed:")
        for line in other[:20]:
            print("  " + line[:200])
    return 0 if server.done.is_set() and not broken else 1


if __name__ == "__main__":
    sys.exit(main())
